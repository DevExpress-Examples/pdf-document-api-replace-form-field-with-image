<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="AddressFormField.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DevExpress.Document.Processor" Version="26.1.5" />
    <PackageReference Include="DevExpress.Drawing.Skia" Version="26.1.5" />
    <PackageReference Include="DevExpress.Pdf.Drawing" Version="26.1.5" />
  </ItemGroup>

</Project>
